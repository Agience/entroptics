# Git normalizes text to LF in the repository on commit and leaves working copies alone.
* text=auto

# Line endings that are load-bearing, not cosmetic. A shell script or a Dockerfile with CRLF fails
# inside a Linux container with an error that names the interpreter, not the line endings.
*.sh   text eol=lf
*.bash text eol=lf
*.py   text eol=lf
Dockerfile text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf

# Windows-native files keep CRLF deliberately.
*.bat text eol=crlf
*.ps1 text eol=crlf
